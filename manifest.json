{
  "manifest_version": 3,
  "name": "Kufar Currency Converter",
  "version": "1.5",
  "description": "Конвертирует цены из BYN в USD на сайте kufar.by",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Kufar Currency Converter"
  },
  "options_page": "options.html",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://re.kufar.by/*",
    "https://www.kufar.by/*",
    "https://api.nbrb.by/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://re.kufar.by/*",
        "https://www.kufar.by/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
